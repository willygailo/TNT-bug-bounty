# ==============================================================================
# TNT PH Bug Bounty - Git Ignore Rules
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
creds.json
tokens.json
secrets.yaml

# SQLite Temporary Files & Lock Files
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# Generated Bug Bounty Reports & Data Exports
tnt_export_*.json
tnt_report_*.md
report_*.md
scan_output/
raw_logs/
*.log

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
